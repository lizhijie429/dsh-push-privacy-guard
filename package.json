{
  "name": "dsh-push-privacy-guard",
  "version": "0.4.0",
  "description": "DSH Host plugin: privacy-check git commit / push (and gh repo sync) before upload; asks the user through the DSH approval UI and keeps approved items in a manageable whitelist.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "client.js",
    "lib",
    "vendor",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "privacy",
    "secret-scanning",
    "git"
  ],
  "license": "MIT",
  "author": "lizhijie429",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizhijie429/dsh-push-privacy-guard.git"
  },
  "homepage": "https://github.com/lizhijie429/dsh-push-privacy-guard#readme",
  "bugs": {
    "url": "https://github.com/lizhijie429/dsh-push-privacy-guard/issues"
  }
}
